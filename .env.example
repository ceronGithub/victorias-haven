# ─────────────────────────────────────────────────────────────
# Victoria's Haven — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── EmailJS ───────────────────────────────────────────────────
# Found in: EmailJS Dashboard → Email Services / Templates / Account
VITE_EMAILJS_SERVICE_ID=service_oj9jwon
VITE_EMAILJS_TEMPLATE_ID=template_z9goxpk
VITE_EMAILJS_PUBLIC_KEY=cUR1LKEI711O_10So

# ── Cloudflare R2 — CLIENT (public, safe to expose) ───────────
# Found in: Cloudflare R2 → your bucket → Settings → Public Access URL
# Used by: src/lib/r2.js getR2Url() — builds public image URLs in the browser
VITE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ── Cloudflare R2 — SERVER (secret, never expose to client) ───
# Found in: Cloudflare Dashboard → R2 → Manage R2 API tokens
# Used by: api/r2-list.js (Vercel serverless function only)
# These are NOT prefixed with VITE_ so Vite never bundles them into the client.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
